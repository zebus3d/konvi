[Desktop Entry]
Type=Application
Name=Konvi
GenericName=Video converter
GenericName[es]=Conversor de vídeo
Comment=Convert videos and audio to MP4, MKV, WebM, DaVinci, YouTube, phones...
Comment[es]=Convierte vídeos y audio a MP4, MKV, WebM, DaVinci, YouTube, móvil...
Exec="@KONVI@" %F
Icon=konvi
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=convert;video;ffmpeg;mp4;mkv;h264;h265;av1;audio;mp3;
Keywords[es]=convertir;vídeo;video;ffmpeg;mp4;mkv;h264;h265;av1;audio;mp3;
StartupWMClass=konvi
